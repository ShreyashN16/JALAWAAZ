# Jal Awaaz settings. Copy to .env and fill in. Never commit .env or share it.
# Every setting is explained in docs/CONFIGURATION.md.

# ---- Gnani speech APIs (docs.gnani.ai, re-checked 2026-11-13) ----
GNANI_API_KEY=                     # create at app.gnani.ai; sent as header X-API-Key-ID. Keep it secret.
GNANI_STT_MODEL=prisma-v3.0        # set prisma-v2.5 if your key returns INVALID_MODEL for v3.0
GNANI_TTS_MODEL=timbre-v3.0        # or timbre-v2.5. Voices are NOT interchangeable between the two.
TTS_VOICE_MR=Shivani               # v3.0: Shivani, Chetana, Kalpana, Tarika ... | v2.5 Marathi: Zahira, Ishaan
TTS_VOICE_HI=Shivani               # v2.5 Hindi: Nalini, Bhavna, Chitra, Yashvi ...
TTS_VOICE_HIEN=Poorvi              # used only with timbre-v2.5 (language hi-en)
TTS_FORMAT=mp3                     # mp3 (small, streams), wav or ogg for the browser phone
TTS_STREAMING=1                    # Timbre SSE streaming; falls back to the file endpoint automatically
TTS_TELEPHONE_CONTAINER=mulaw      # what telephone mode asks Timbre for (G.711, 8 kHz)
GNANI_CONCURRENCY=1                # some accounts allow only one active request at a time

# ---- Evon v3.3 (open weights: you host it, OpenAI-compatible) ----
EVON_ENABLED=1                     # 0 = rule-based extraction only (labelled in the UI)
EVON_BASE_URL=http://localhost:8001
EVON_SERVED_NAME=evon              # the --served-model-name you started vLLM/SGLang with
EVON_API_KEY=                      # only if your server requires a bearer token

# ---- App ----
APP_SALT=change-me                 # hashes device ids and phone numbers. Use a long random value.
APP_SECRET=change-me-too           # signs staff session cookies. Use a long random value.
ENGINEER_PIN=2468                  # demo PINs (shown on the sign-in page only while unchanged)
OFFICER_PIN=1357
DB_PATH=./jalawaaz.db
DEMO_MODE=1                        # time compressed: callbacks and verification calls in seconds
DEMO_CALLBACK_DELAY_SEC=5
DEMO_VERIFY_DELAY_SEC=8            # real mode uses calling.verify_delay_hours in data/config.json
DEMO_VERIFY_RETRY_SEC=30
DEMO_IGNORE_QUIET_HOURS=1          # demo only; real mode never calls 21:00-07:00
TELEPHONE_MODE=0                   # default for the phone page's 8 kHz line switch
SMS_PROVIDER=console               # writes SMS to the log; nothing is sent
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
